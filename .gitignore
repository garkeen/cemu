# Build output (cmake build dir)
build/

# Object files and binaries anywhere they might stray
*.o
*.obj
*.exe

# x86 realmode build intermediates, regenerated by test/x86/realmode/build.sh
# (scoped so the patterns cannot shadow other test trees)
/test/x86/realmode/*.gen.s
/test/x86/realmode/*.flat.s
/test/x86/realmode/probe.*

# Debug output captures
*.txt
# ...but the build definition is source, not capture output
!CMakeLists.txt
# ...and the dual-run records beside the probes are the probe's own evidence
# (what the reference model answered for the same binary; see probe/*_qemu.txt)
!test/x86/probe/*_qemu.txt

# Editor / OS junk
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Smoke-probe products (the source stays; test/x86/probe/*.asm builds them)
/test/x86/probe/*.bin
# ...and the 1.44MB floppy images the boot-sector probes build into
/test/x86/probe/*.img
