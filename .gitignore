# Build output (Makefile BUILD dir)
build/

# Object files and binaries anywhere they might stray
*.o
*.obj
*.exe

# x86 realmode build intermediates, regenerated by test/x86/realmode/build.sh
# (scoped so the patterns cannot shadow other test trees)
/test/x86/realmode/*.gen.s
/test/x86/realmode/*.flat.s
/test/x86/realmode/probe.*

# Debug output captures
*.txt

# Editor / OS junk
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
